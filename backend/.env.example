# ============ 应用基础 ============
APP_HOST=0.0.0.0
APP_PORT=3003
APP_DEBUG=false

# ============ 数据库 ============
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# ============ JWT 鉴权 ============
# 用 openssl rand -hex 32 生成
JWT_SECRET=change-me-to-a-random-64-char-hex-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# ============ 管理员账户（首次启动写入 DB） ============
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin@2026

# ============ 币安 API（实盘）============
# 注册地址: https://www.binance.com/zh-CN/my/settings/api-management
# 权限只勾选「合约交易」即可，不要勾「提现」
BINANCE_API_KEY=
BINANCE_API_SECRET=
# 是否使用测试网，正式使用请改 false
BINANCE_TESTNET=false
# 行情订阅模式：ws | rest
MARKET_FEED=ws
# 币安期货行情 WS（部分网络需用 /market 前缀）
BINANCE_WS_BASE=wss://fstream.binance.com/market/ws
BINANCE_WS_STREAM=wss://fstream.binance.com/market/stream
MARK_POLL_SEC=1
RUNTIME_PUSH_SEC=2
POST_CLOSE_COOLDOWN_SEC=30

# ============ 策略默认参数（可在前端覆盖） ============
# 是否模拟下单（不真发单，仅记录），首次部署建议 true 跑几天看信号
PAPER_TRADING=true
# 本金来源：env 表示用下面的固定值，account 表示实时拉取账户余额
CAPITAL_SOURCE=env
CAPITAL_USDT=200
# 杠杆
LEVERAGE=20

# ============ CoinGecko（动态选币市值） ============
COINGECKO_API_BASE=https://api.coingecko.com/api/v3
COINGECKO_TIMEOUT=30
